{
  // Cloudflare Workers config for the live site. See DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "label-payouts",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "label-payouts" }],
  "hyperdrive": [
    {
      // The Neon database, through Hyperdrive (`wrangler hyperdrive create label-payouts-db`).
      "binding": "HYPERDRIVE",
      "id": "611c1e7ea2f14243a998f8feeeeb12a7",
      // `npm run preview` uses the local database instead.
      "localConnectionString": "postgres://postgres:local@127.0.0.1:5433/label_payouts"
    }
  ],
  // "Sync now" requests for the catalog sync that runs on a Mac (npm run sync-catalog:schedule).
  "kv_namespaces": [{ "binding": "CATALOG_KV", "id": "cdc0461f45e14130b590ef665548ff7a" }],
  // Receipt photos and PDFs (src/server/receipt-store.ts). Private: served only through the app.
  "r2_buckets": [{ "binding": "RECEIPTS", "bucket_name": "label-payouts-receipts" }],
  // Served at labelmaker.ing (the domain is on this Cloudflare account).
  "routes": [{ "pattern": "labelmaker.ing", "custom_domain": true }],
  // Sync every account with Bandcamp once an hour, in the background.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    // The site's address. Sign-ins are tied to it.
    "BETTER_AUTH_URL": "https://labelmaker.ing",
    // Who can see /admin (comma-separated).
    "SITE_ADMIN_EMAILS": "reactionfutureinstitute@gmail.com"
  }
}
